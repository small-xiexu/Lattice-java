{
  "suiteId": "e2e-clean-rebuild-query-regression",
  "version": "2026-05-23",
  "description": "干净数据库全链路 E2E Query 验收套件。基于 docs/reports/e2e/full_rebuild_e2e_validation_asset_design_report.md 第 3 节设计的 12 个 case，覆盖 6 份知识源（D1-D6）的 ANSWER/ABSTAIN/结构化/多跳/拒答全部行为维度。供 scripts/run-query-regression.mjs 直接读取执行。",
  "coverageDimensions": [
    "长文档事实提取",
    "架构边界与职责",
    "配置精确查值",
    "运行态状态说明",
    "结构化行定位",
    "结构化聚合统计",
    "多跳综合推理",
    "踩坑经验提取",
    "配置错误诊断",
    "无命中拒答保护"
  ],
  "replayArtifacts": [
    "query_results.jsonl",
    "query_summary.tsv",
    "query_metrics.json",
    "query_replay_manifest.json"
  ],
  "defaults": {
    "timeoutMs": 120000,
    "minSourceCount": 1,
    "minCitationCoverage": 0.6
  },
  "gates": {
    "minCasePassRate": 0.8,
    "maxHttpFailureRate": 0.0,
    "maxTimeoutRate": 0.05,
    "maxFallbackRate": 0.4,
    "minLlmSuccessRate": 0.4,
    "minAverageCitationCoverage": 0.6
  },
  "cases": [
    {
      "id": "E2E-001",
      "category": "长文档列举",
      "question": "当前项目的质量打磨阶段有哪些禁止事项？请至少列出 5 条。",
      "forceSimple": true,
      "expect": {
        "httpStatus": 200,
        "answerOutcomeAny": [
          "SUCCESS",
          "PARTIAL_ANSWER"
        ],
        "generationModeAny": [
          "LLM"
        ],
        "modelExecutionStatusAny": [
          "SUCCESS"
        ],
        "requireQueryId": true,
        "minSourceCount": 1,
        "minCitationCoverage": 0.6,
        "retrievalTargets": [
          "docs/quality-progress-and-lessons.md"
        ],
        "requiredAnswerTerms": [
          "禁止事项",
          "主链",
          "agent",
          "SWIP",
          "特判",
          "baseline"
        ],
        "requiredSourceTerms": [
          "quality-progress-and-lessons"
        ],
        "answerability": "ANSWERABLE",
        "expectedPoints": [
          "不准多个 agent 同时改主链",
          "不准在 SWIP clean 库上跑主 baseline",
          "不准继续调题集来追 pass",
          "不准写 SWIP/文档/case 特判",
          "不准跳过 redline/mvn test/baseline 归因",
          "不准把 rule-based review 描述成 LLM 内容审查"
        ],
        "expectedEvidence": [
          {
            "source": "docs/quality-progress-and-lessons.md",
            "quoteHint": "当前禁止事项章节，列出禁止事项清单"
          }
        ],
        "mustNotClaim": [
          "把\"当前禁止事项\"之外的规则当作禁止事项列出"
        ],
        "humanJudgement": {
          "passRule": "禁止事项必须来自台账的\"当前禁止事项\"章节，事项内容和数量与源文一致；至少覆盖 5 条。"
        }
      }
    },
