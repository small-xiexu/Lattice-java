<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.payment.mapper.PaymentOrderMapper">

    <resultMap id="PaymentOrderMap" type="com.example.payment.domain.PaymentOrder">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="merchant_id" property="merchantId"/>
        <result column="amount" property="amount"/>
        <result column="currency" property="currency"/>
        <result column="channel" property="channel"/>
        <result column="status" property="status"/>
        <result column="idempotency_key" property="idempotencyKey"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectByOrderId" resultMap="PaymentOrderMap">
        SELECT id, order_id, merchant_id, amount, currency, channel,
               status, idempotency_key, created_at, updated_at
        FROM payment_orders
        WHERE order_id = #{orderId}
          AND deleted = 0
    </select>

    <select id="countByMerchantAndStatus" resultType="int">
        SELECT COUNT(*)
        FROM payment_orders
        WHERE merchant_id = #{merchantId}
          AND status = #{status}
          AND deleted = 0
    </select>
</mapper>
