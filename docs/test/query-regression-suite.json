      "forceDeep": true,
      "maxLlmCalls": 4,
      "overallTimeoutMs": 180000,
      "timeoutMs": 210000,
      "expect": {
        "httpStatus": 200,
        "answerOutcomeAny": [
          "SUCCESS",
          "PARTIAL_ANSWER"
        ],
        "generationModeAny": [
          "LLM",
          "FALLBACK"
        ],
        "modelExecutionStatusAny": [
          "SUCCESS",
          "DEGRADED",
          "FAILED"
        ],
        "requireQueryId": true,
        "minSourceCount": 1,
        "retrievalTargets": [
          "docs/卡券三期-迁移方案.md"
        ],
        "requiredAnswerTerms": [
          "FC",
          "DPFM",
          "MQ"
        ],
        "answerability": "ANSWERABLE",
        "expectedPoints": [
          "FC 是迁移前/旧链路中的履约中台或旧接口契约来源",
          "DPFM 新链路入口侧通过入口防腐层保持 API path、请求参数、响应参数与 FC 兼容",
          "上游只需切换调用地址，降低上游改造成本",
          "SRKIT / SVC 相关 MQ 消费者统一落在 dpfm-callback-service",
          "dpfm-consumer-service 保留原有消费职责，dpfm-api-service 只做 API 接收、持久化、MQ 发送"
        ],
        "expectedEvidence": [
          {
            "source": "docs/卡券三期-迁移方案.md",
            "quoteHint": "入口防腐层、上游感知最小化、MQ 消费者归属三组约束"
          }
        ],
        "mustNotClaim": [
          "DPFM 可以改变对外接口契约",
          "dpfm-api-service 负责消费自己发出的 MQ",
          "Deep Research 在无证据锚点时仍给出确定结论"
        ],
        "humanJudgement": {
          "passRule": "必须综合 FC/DPFM/入口防腐层/MQ 边界四类关系，并解释降低上游改造成本的依据；至少 1 个可核验证据锚点支撑核心结论。"
        }
      }
    },
