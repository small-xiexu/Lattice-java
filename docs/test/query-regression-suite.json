{
  "suiteId": "default-real-query-regression",
  "version": "2026-05-06",
  "description": "固定真实 Query 回归题集。题集只定义问题、运行参数、通用验收字段与最小人工判定线索，不进入 Query 主链实现。",
  "coverageDimensions": [
    "运行态直答",
    "结构化行定位",
    "结构化字段投影",
    "结构化聚合统计",
    "结构化两行对比",
    "精确路径解释",
    "架构边界解释",
    "本地配置解释",
    "Deep Research 多跳综合",
    "无命中保护"
  ],
  "replayArtifacts": [
    "query_results.jsonl",
    "query_summary.tsv",
    "query_metrics.json",
    "query_replay_manifest.json"
  ],
  "defaults": {
    "timeoutMs": 120000,
    "minSourceCount": 1,
    "minCitationCoverage": 0.6
  },
  "gates": {
    "minCasePassRate": 0.8,
    "maxHttpFailureRate": 0.0,
    "maxTimeoutRate": 0.05,
    "maxFallbackRate": 0.4,
    "minLlmSuccessRate": 0.4,
    "minAverageCitationCoverage": 0.6
  },
  "cases": [
    {
      "id": "Q-RUNTIME-OCR-001",
      "category": "运行态说明",
      "question": "现在 OCR / 文档识别状态怎样，图片和扫描 PDF 可用吗？",
      "forceSimple": true,
      "expect": {
        "httpStatus": 200,
        "answerOutcomeAny": [
          "SUCCESS"
        ],
        "generationModeAny": [
          "LLM",
          "RULE_BASED"
        ],
        "modelExecutionStatusAny": [
          "SUCCESS",
          "SKIPPED"
        ],
        "requireQueryId": true,
        "minSourceCount": 1,
        "minCitationCoverage": 0.6,
        "requiredAnswerTerms": [
          "OCR",
          "文档识别",
          "配置",
          "连接"
        ],
        "requiredSourceTerms": [
          "文档识别与OCR运行态说明"
        ],
        "answerability": "ANSWERABLE",
        "expectedPoints": [
          "说明 OCR / 文档识别当前可用状态取决于 Provider 连接配置",
          "说明图片或扫描 PDF 的识别是否可用取决于 OCR Provider 是否已配置并启用",
          "答案应基于知识库中的运行态说明文档，走通用 query graph"
        ],
        "expectedEvidence": [
          {
            "source": "docs/文档识别与OCR运行态说明.md",
            "quoteHint": "OCR Provider 连接配置、文件类型识别路径、管理入口 /api/v1/admin/document-parse/connections"
          }
        ],
        "mustNotClaim": [
          "在无运行态证据时声称 OCR 已可用",
          "把架构中支持 PDF 解析等同于 OCR 已上线"
        ],
        "humanJudgement": {
          "passRule": "回答需基于知识库运行态文档说明 OCR/文档识别状态和图片/扫描 PDF 可用性；允许走通用 query graph 返回 LLM 生成结果。"
        }
      }
    },
    {
      "id": "Q-STRUCT-ROW-001",
      "category": "Excel 行定位",
      "question": "scenario_id=100912 这一行的 case_num、场景名称、备注分别是什么？注意不要把 scenario_id 当 case_num。",
      "expect": {
        "httpStatus": 200,
        "answerOutcomeAny": [
          "SUCCESS"
        ],
        "generationModeAny": [
          "RULE_BASED",
          "LLM"
        ],
        "modelExecutionStatusAny": [
          "SKIPPED",
          "SUCCESS"
        ],
        "minSourceCount": 1,
        "requiredAnswerTerms": [
          "100912",
          "case_num",
          "remark"
        ],
        "requiredSourceTerms": [
          "scenarios.xlsx"
        ],
        "answerability": "ANSWERABLE",
        "expectedPoints": [
          "定位 scenario_id=100912 对应的唯一行",
          "返回该行 case_num、场景名称、备注",
          "不得把 scenario_id 当作 case_num"
        ],
        "expectedEvidence": [
          {
            "source": "docs/scenarios.xlsx",
            "quoteHint": "scenario_id=100912 所在行"
          }
        ],
        "mustNotClaim": [
          "case_num 等于 100912，除非表格原始行确实如此",
          "使用其他 scenario_id 或其他行的值"
        ],
        "humanJudgement": {
          "passRule": "三个字段值必须来自同一行，字段名和值对应正确；允许中英文字段名混用，但不能串行。"
        }
      }
    },
    {
      "id": "Q-STRUCT-PROJECTION-001",
      "category": "Excel 字段投影",
      "question": "case_num=100714 这一行的 name、expected、module 分别是什么？",
      "expect": {
        "httpStatus": 200,
        "answerOutcomeAny": [
          "SUCCESS"
        ],
        "generationModeAny": [
          "RULE_BASED",
          "LLM"
        ],
        "modelExecutionStatusAny": [
          "SKIPPED",
          "SUCCESS"
        ],
        "minSourceCount": 1,
        "requiredAnswerTerms": [
          "100714",
          "name",
          "expected",
          "module"
        ],
        "requiredSourceTerms": [
          "scenarios.xlsx"
        ],
        "answerability": "ANSWERABLE",
        "expectedPoints": [
          "定位 case_num=100714 对应的唯一行",
          "返回该行 name、expected、module 三个字段",
          "只投影被问到的字段，不混入其他行"
        ],
        "expectedEvidence": [
          {
            "source": "docs/scenarios.xlsx",
            "quoteHint": "case_num=100714 所在行"
          }
        ],
        "mustNotClaim": [
          "使用 case_num=100716 或其他行的字段值",
          "把 expected 字段解释成模型推测结果"
        ],
        "humanJudgement": {
          "passRule": "name、expected、module 三个值均需与表格行一致；少一个字段或引用错行均不通过。"
        }
      }
    },
    {
      "id": "Q-STRUCT-AGG-001",
      "category": "Excel 聚合统计",
      "question": "按 category 统计场景用例各有多少条？请列出每个 category 和数量。",
      "expect": {
        "httpStatus": 200,
        "answerOutcomeAny": [
          "SUCCESS",
          "PARTIAL_ANSWER"
        ],
        "generationModeAny": [
          "RULE_BASED",
          "LLM"
        ],
        "modelExecutionStatusAny": [
          "SKIPPED",
          "SUCCESS"
        ],
        "minSourceCount": 1,
        "requiredAnswerTerms": [
          "category",
          "数量"
        ],
        "requiredSourceTerms": [
          "scenarios.xlsx"
        ],
        "answerability": "ANSWERABLE",
        "expectedPoints": [
          "按 category 分组统计 scenarios.xlsx 中场景用例数量",
          "列出每个 category 及其数量",
          "数量之和应等于参与统计的总行数"
        ],
        "expectedEvidence": [
          {
            "source": "docs/scenarios.xlsx",
            "quoteHint": "category 列及所有数据行"
          }
        ],
        "mustNotClaim": [
          "只列部分 category 却声称完整",
          "用非 category 字段分组"
        ],
        "humanJudgement": {
          "passRule": "分组字段必须是 category；所有 category 都应出现，数量不能凭模型估算。"
        }
      }
    },
    {
      "id": "Q-STRUCT-COMPARE-001",
      "category": "Excel 两行对比",
      "question": "对比 case_num=100714 和 case_num=100716：两行的 name、expected 有什么差异？",
      "expect": {
        "httpStatus": 200,
        "answerOutcomeAny": [
          "SUCCESS",
          "PARTIAL_ANSWER"
        ],
        "generationModeAny": [
          "RULE_BASED",
          "LLM"
        ],
        "modelExecutionStatusAny": [
          "SKIPPED",
          "SUCCESS"
        ],
        "minSourceCount": 1,
        "requiredAnswerTerms": [
          "100714",
          "100716"
        ],
        "requiredSourceTerms": [
          "scenarios.xlsx"
        ],
        "answerability": "ANSWERABLE",
        "expectedPoints": [
          "分别定位 case_num=100714 和 case_num=100716 两行",
          "比较两行 name 字段差异",
          "比较两行 expected 字段差异"
        ],
        "expectedEvidence": [
          {
            "source": "docs/scenarios.xlsx",
            "quoteHint": "case_num=100714 与 case_num=100716 两行"
          }
        ],
        "mustNotClaim": [
          "只回答其中一行",
          "把 module 或其他字段当成 name/expected 差异"
        ],
        "humanJudgement": {
          "passRule": "必须同时覆盖两行、两个字段；允许用表格表达，不能把缺失字段编造成差异。"
        }
      }
    },
    {
      "id": "Q-EXACT-PATH-001",
      "category": "接口路径精确解释",
      "question": "/api/v2/fulfillment/request/return 这个是什么接口？它迁移后对外 path 可以改吗？",
      "expect": {
        "httpStatus": 200,
        "answerOutcomeAny": [
          "SUCCESS",
          "PARTIAL_ANSWER"
        ],
        "generationModeAny": [
          "LLM"
        ],
        "modelExecutionStatusAny": [
          "SUCCESS"
        ],
        "requireQueryId": true,
        "minSourceCount": 1,
        "minCitationMarkerCount": 1,
        "retrievalTargets": [
          "docs/卡券三期-迁移方案.md"
        ],
        "requiredAnswerTerms": [
          "/api/v2/fulfillment/request/return",
          "path"
        ],
        "forbiddenAnswerTerms": [
          "/api/v1/srkit",
          "/api/v1/svc"
        ],
        "answerability": "ANSWERABLE",
        "expectedPoints": [
          "识别 /api/v2/fulfillment/request/return 是迁移方案中的履约退货/return 请求接口",
          "说明迁移后对外 path 应保持与 FC 旧接口兼容或不得随意改动",
          "解释原因应落在入口防腐层、上游感知最小化或接口契约兼容"
        ],
        "expectedEvidence": [
          {
            "source": "docs/卡券三期-迁移方案.md",
            "quoteHint": "/api/v2/fulfillment/request/return 与入口防腐层 / path 兼容约束"
          }
        ],
        "mustNotClaim": [
          "迁移后可以任意改 path",
          "把 /api/v1/srkit 或 /api/v1/svc 当作该接口新 path"
        ],
        "humanJudgement": {
          "passRule": "必须回答接口含义和 path 是否可改两个子问题；引用需支撑接口 path 或防腐层兼容约束。"
        }
      }
    },
    {
      "id": "Q-MQ-BOUNDARY-001",
      "category": "架构原因",
      "question": "为什么 dpfm-api-service 不应该消费自己发的 MQ？dpfm-consumer-service 和回调类服务边界是什么？",
      "expect": {
        "httpStatus": 200,
        "answerOutcomeAny": [
          "SUCCESS",
          "PARTIAL_ANSWER"
        ],
        "generationModeAny": [
          "LLM"
        ],
        "modelExecutionStatusAny": [
          "SUCCESS"
        ],
        "requireQueryId": true,
        "minSourceCount": 1,
        "minCitationMarkerCount": 1,
        "retrievalTargets": [
          "docs/卡券三期-迁移方案.md"
        ],
        "requiredAnswerTerms": [
          "dpfm-api-service",
          "MQ"
        ],
        "minCitationCoverage": 0.5,
        "answerability": "ANSWERABLE",
        "expectedPoints": [
          "dpfm-api-service 只做 API 接收、持久化、MQ 发送",
          "dpfm-api-service 不消费自己发出的 MQ",
          "SRKIT / SVC 相关 MQ 消费者统一落在 dpfm-callback-service",
          "dpfm-consumer-service 仅保留原有电商券、订单、归档等消费职责",
          "边界原因应围绕职责分离、入口服务不承担消费逻辑和迁移新增消费者归属"
        ],
        "expectedEvidence": [
          {
            "source": "docs/卡券三期-迁移方案.md",
            "quoteHint": "MQ 消费者归属（强约束）与 dpfm-api-service 职责说明"
          }
        ],
        "mustNotClaim": [
          "dpfm-api-service 负责消费自己发出的 MQ",
          "dpfm-consumer-service 新增 SRKIT/SVC 消费者",
          "消费者边界可以由调用方自行决定"
        ],
        "humanJudgement": {
          "passRule": "至少覆盖 api-service 职责、callback-service 归属、consumer-service 保留职责三类要点；citationCoverage 不低于 case 阈值。"
        }
      }
    },
    {
