          "FALLBACK",
          "LLM"
        ],
        "modelExecutionStatusAny": [
          "SKIPPED",
          "FAILED",
          "DEGRADED",
          "SUCCESS"
        ],
        "minSourceCount": 0,
        "minCitationCoverage": 0,
        "forbiddenAnswerTerms": [
          "负责人是",
          "取值为"
